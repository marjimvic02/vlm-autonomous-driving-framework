# Copy to .env in the repository root. Never commit the populated file.
# Launch arguments override LLM_PROVIDER and LLM_MODEL during a full launch.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3.5:2b
OLLAMA_API_URL=http://localhost:11434/api/chat
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional overrides when running outside the repository root.
# TFM_OUTPUT_DIR=/absolute/path/to/run-outputs
# TFM_ENV_FILE=/absolute/path/to/.env
