<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>decision_making_module</name>
  <version>0.1.0</version>
  <description>Multimodal high-level driving decisions using local or cloud VLMs.</description>
  <maintainer email="marjimvic02@users.noreply.github.com">marjimvic</maintainer>
  <license>LicenseRef-Proprietary</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>cv_bridge</depend>
  <depend>python3-opencv</depend>
  <depend>python3-requests</depend>
  <!-- openai and python-dotenv are pip-only; declared in setup.py install_requires -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
